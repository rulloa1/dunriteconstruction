# Supabase configuration for the TanStack Start application.
# Use the VITE_ variables for the browser client. The unprefixed variables are available as SSR fallbacks.
# Set values in your local .env file and deployment platform settings; never commit runtime credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
